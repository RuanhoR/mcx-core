{
  "name": "mcx-core",
  "version": "0.0.0",
  "description": "MCX CORE",
  "license": "MIT",
  "author": {
    "name": "ruanhor",
    "email": "a@ruanhor.dpdns.org",
    "url": "https://github.com/RuanhoR/"
  },
  "readme": "./README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruanhor/mcx-core"
  },
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "lint:packages": "pnpm -r lint",
    "lint:packages:fix": "pnpm -r lint:fix",
    "format": "prettier ./packages/create-mbler/src ./packages/core/src ./packages/types/index.d.ts ./packages/client/src --write",
    "test": "pnpm -r test",
    "build": "pnpm -r --filter=@mbler/mcx-core --filter=@mbler/mcx build",
    "check": "pnpm test && pnpm lint:packages && pnpm -r exec tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "workspaces": [
    "packages/client",
    "packages/types",
    "packages/core",
    "packages/create-mbler"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@minecraft/server": "2.0.0",
    "@minecraft/server-ui": "2.0.0",
    "@rollup/plugin-commonjs": "29.0.1",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/babel__generator": "7.27.0",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.17.0",
    "picocolors": "^1.1.1",
    "prettier": "3.8.3",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "6.3.0",
    "simple-git-hooks": "^2.13.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
