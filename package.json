{
  "name": "mcx-core",
  "version": "0.0.0",
  "description": "MCX CORE",
  "license": "MIT",
  "author": {
    "name": "ruanhor",
    "email": "a@ruanhor.dpdns.org",
    "url": "https://github.com/RuanhoR/"
  },
  "engines": {
    "node": ">=22"
  },
  "readme": "./README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruanhor/mcx-core"
  },
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "lint:packages": "pnpm -r lint",
    "lint:packages:fix": "pnpm -r lint:fix",
    "format": "prettier ./packages/create-mbler/src ./packages/core/src ./packages/types/index.d.ts ./packages/client/src --write",
    "test": "vitest run",
    "build": "pnpm -r build",
    "check": "pnpm test && pnpm lint:packages && pnpm -r --filter=@mbler/mcx-core --filter=@mbler/mcx --filter=create-mbler exec tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "workspaces": [
    "packages/client",
    "packages/types",
    "packages/core",
    "packages/create-mbler"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@minecraft/server": "2.9.0-beta.1.26.30-preview.21",
    "@minecraft/server-ui": "2.2.0-beta.1.26.30-preview.30",
    "@types/babel__generator": "7.27.0",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.17.0",
    "picocolors": "^1.1.1",
    "prettier": "3.8.3",
    "rolldown": "1.0.0-rc.18",
    "rolldown-plugin-dts": "0.25.2",
    "simple-git-hooks": "^2.13.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  },
  "simple-git-hooks": {
    "config": ".simple-git-hooks.mjs"
  }
}