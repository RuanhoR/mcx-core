{
  "name": "mcx-core",
  "version": "0.0.0",
  "description": "MCX CORE",
  "license": "MIT",
  "author": {
    "name": "ruanhor",
    "email": "a@ruanhor.dpdns.org",
    "url": "https://github.com/RuanhoR/"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "lint:packages": "pnpm -r lint",
    "lint:packages:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "build": "pnpm -r --filter=@mbler/mcx-core --filter=@mbler/mcx build",
    "check": "pnpm test && pnpm lint:packages && pnpm -r exec tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "workspaces": [
    "packages/client",
    "packages/types",
    "packages/core"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.17.0",
    "picocolors": "^1.1.1",
    "simple-git-hooks": "^2.13.1"
  }
}
