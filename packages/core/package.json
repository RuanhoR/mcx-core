{
  "name": "@mbler/mcx-core",
  "version": "0.0.8-rc.4",
  "description": "a DSL compiler of mcx",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "test": "cd __test__ && npm run test",
    "build": "rollup -c"
  },
  "keywords": [
    "compiler",
    "minecraft",
    "dsl"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "dependencies": {
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/types": "7.28.6",
    "@mbler/mcx-types": "workspace:*",
    "@volar/language-core": "^2.4.28",
    "magic-string": "0.30.21",
    "rollup": "4.59.0",
    "typescript": "5.9.3"
  },
  "module": "commjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "client.d.ts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "author": "ruanhor",
  "license": "MIT"
}
