{
  "name": "@mbler/mcx-core",
  "version": "0.1.2-rc.8",
  "description": "a DSL compiler of mcx",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "rolldown -c"
  },
  "keywords": [
    "compiler",
    "minecraft",
    "dsl"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "repository": {
    "directory": "/packages/core",
    "type": "git",
    "url": "https://github.com/RuanhoR/mcx-core"
  },
  "dependencies": {
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/types": "7.28.6",
    "@mbler/mcx-component": "workspace:*",
    "@mbler/mcx-types": "workspace:*",
    "@volar/language-core": "^2.4.28",
    "magic-string": "0.30.21",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "rolldown": "1.0.0-rc.18",
    "rolldown-plugin-dts": "0.25.2",
    "rollup": "4.59.0"
  },
  "peerDependencies": {
    "rolldown": "1.0.0-rc.18",
    "rollup": "4.59.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "client.d.ts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "author": "ruanhor",
  "license": "MIT",
  "type": "module"
}
