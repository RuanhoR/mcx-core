{
  "name": "@mbler/eslint-plugin-mcx",
  "version": "0.0.1",
  "description": "ESLint parser and rules for .mcx files (Minecraft Bedrock DSL by mbler)",
  "keywords": [
    "eslint",
    "eslintplugin",
    "minecraft",
    "mcx",
    "mbler",
    "dsl"
  ],
  "license": "MIT",
  "author": {
    "name": "ruanhor",
    "email": "a@ruanhor.dpdns.org",
    "url": "https://github.com/RuanhoR/"
  },
  "repository": {
    "directory": "/packages/eslint-plugin-mcx",
    "type": "git",
    "url": "https://github.com/RuanhoR/mcx-core"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": {
      "require": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "type-check": "tsc --noEmit",
    "gen:events": "node scripts/generate-events.mjs"
  },
  "dependencies": {
    "@mbler/mcx-core": "workspace:*",
    "@typescript-eslint/parser": "^8.59.1",
    "@typescript-eslint/types": "^8.59.1"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^9.17.0",
    "rolldown": "^1.2.0",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
