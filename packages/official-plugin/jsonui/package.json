{
  "name": "@mbler/mcx-plugin-jsonui",
  "version": "0.0.1-alpha.2",
  "description": "Official MCX compiler plugin for Minecraft Bedrock JSON UI (<Ui type=\"jsonui\">)",
  "keywords": [
    "minecraft",
    "bedrock",
    "mcx",
    "mbler",
    "json-ui",
    "plugin"
  ],
  "license": "MIT",
  "author": {
    "name": "ruanhor",
    "email": "a@ruanhor.dpdns.org",
    "url": "https://github.com/RuanhoR/"
  },
  "repository": {
    "directory": "/packages/official-plugin/jsonui",
    "type": "git",
    "url": "https://github.com/Ruanhor/mcx-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "import": "./dist/component.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mbler/mcx-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "rolldown": "^1.2.0",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
